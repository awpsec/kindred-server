# Local server: docker compose up -d, then http://127.0.0.1:9444
KINDRED_PORT=9444
KINDRED_PUBLIC_URL=http://127.0.0.1:9444
KINDRED_VM_CPUS=2
KINDRED_VM_MEMORY_MB=6144
KINDRED_VM_DISK_GB=30
KINDRED_VM_MAX_RUNNING=4
KINDRED_OPEN_REGISTRATION=true
# Public HTTPS server: point this hostname at the VPS and use
# docker compose --profile public up -d
# KINDRED_DOMAIN=kindred.example.com
# KINDRED_PUBLIC_URL=https://kindred.example.com
# For a company, close registration after the first account and use invitations.
