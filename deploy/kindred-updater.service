[Unit]
Description=Kindred host update supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/kindred/server-updater.py
Restart=on-failure
RuntimeDirectory=kindred-updater
RuntimeDirectoryMode=0755
UMask=0077

[Install]
WantedBy=multi-user.target
