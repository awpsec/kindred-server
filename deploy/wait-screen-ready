#!/bin/sh
# Desktop readiness is independent of restored application windows. A saved
# browser profile can legitimately restore no window; it must not restart X11.
set -eu
screen=${1:-1}
case "$screen" in ''|*[!0-9]*) exit 2;; esac
[ "$screen" -ge 1 ] && [ "$screen" -le 32 ] || exit 2
export DISPLAY=:$screen
ready() {
    xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 || return 1
    xdotool search --onlyvisible --name '^Kindred Dock$' >/dev/null 2>&1 || return 1
    return 0
}
i=0
until ready; do
    i=$((i+1))
    [ "$i" -lt 100 ] || { echo 'The bot desktop did not become ready.' >&2; exit 1; }
    sleep 0.2
done
