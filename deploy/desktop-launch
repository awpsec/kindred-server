#!/bin/sh
set -eu
screen=${DISPLAY#:}; screen=${screen%%.*}
case "$screen" in ''|*[!0-9]*) exit 2;; esac
[ "$screen" -ge 1 ] && [ "$screen" -le 32 ] || exit 2
cd /workspace
case "${1:-}" in
  applications) exec rofi -show drun -show-icons -display-drun Applications -theme /usr/local/share/kindred/desktop/applications.rasi;;
  browser) exec /usr/local/lib/kindred/browser-launch.py --screen "$screen" --mode restore;;
  browser-new) exec /usr/local/lib/kindred/browser-launch.py --screen "$screen" --mode new;;
  files) exec pcmanfm --profile="kindred-$screen" --new-win /workspace;;
  terminal) exec konsole --separate --hide-menubar --hide-tabbar --profile /usr/local/share/kindred/desktop/Kindred.profile --workdir /workspace;;
  *) exit 2;;
esac
