#!/bin/sh
# One native wallpaper/dock per X display, including hot application to live screens.
set -eu
screen=${DISPLAY#:}; screen=${screen%%.*}
case "$screen" in ''|*[!0-9]*) exit 2;; esac
[ "$screen" -ge 1 ] && [ "$screen" -le 32 ] || exit 2
state=/home/bot/.local/share/kindred
mkdir -p "$state"
exec 9>"$state/desktop-shell-$screen.lock"
flock -n 9 || exit 0
feh --no-fehbg --bg-fill /usr/local/share/kindred/desktop/wallpaper.png
# Keep the lock in this supervisor; launched apps must not inherit it.
tint2 -c /usr/local/share/kindred/desktop/tint2rc 9>&- &
dock=$!
trap 'kill "$dock" 2>/dev/null || true' EXIT INT TERM
wait "$dock"
