def app_key(window):
    name = (window.get_class_group_name() or window.get_class_instance_name() or '').lower()
    for key, aliases in ALIASES:
        if any(alias in name for alias in aliases):
            return key
    return name or str(window.get_xid())


def app_title(window):
    name = window.get_class_group_name() or window.get_class_instance_name() or 'Application'
    return name.replace('-', ' ').title() if name.islower() else name


def timezone_name():
    if os.environ.get('TZ'):
        return os.environ['TZ'].lstrip(':')
    try:
        return Path('/etc/timezone').read_text().strip()
    except OSError:
        target = os.path.realpath('/etc/localtime')
        return target.split('zoneinfo/', 1)[1] if 'zoneinfo/' in target else ''


def letter_tile(title, size=ICON):
    """Kindred-style tile for applications that publish no icon of their own."""
    letter = html.escape((title.strip()[:1] or '?').upper())
    tint = TILES[sum(map(ord, title)) % len(TILES)]
    svg = ('<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64">'
           f'<rect x="2" y="2" width="60" height="60" rx="15" fill="{tint}"/>'
           '<rect x="2.5" y="2.5" width="59" height="59" rx="14.5" fill="none" stroke="#fff" stroke-opacity=".1"/>'
           f'<text x="32" y="42" font-family="DejaVu Sans" font-size="27" font-weight="bold" '
           f'fill="#e5e9ef" text-anchor="middle">{letter}</text></svg>')
    try:
        loader = GdkPixbuf.PixbufLoader.new_with_type('svg')
        loader.set_size(size, size)
        loader.write(svg.encode())
        loader.close()
        return loader.get_pixbuf()
    except GLib.Error:
        # Old guests may not have the SVG loader yet. Keep the desktop usable.
        tile = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, True, 8, size, size)
        tile.fill(int(tint.lstrip('#') + 'ff', 16))
        return tile


def icon_for(key, title, window=None, size=ICON, generic=None):
    asset = ASSETS / (key + '.svg')
    if asset.is_file():
        try:
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(str(asset), size, size, True)
        except GLib.Error:
            pass
    icon = window.get_icon() if window else None
    # Openbox gives icon-less clients its stock icon, which libwnck does not flag as fallback.
    if icon and not window.get_icon_is_fallback() and icon.get_pixels() != generic:
        return icon.scale_simple(size, size, GdkPixbuf.InterpType.HYPER)
    return letter_tile(title, size)


def describe(title, windows):
    if not windows:
        return title
    count = len(windows)
    hidden = sum(w.is_minimized() for w in windows)
    text = f'{title} · {count} window' + ('s' if count > 1 else '')
    if hidden:
        text += ' · all minimized' if hidden == count else f' · {hidden} minimized'
    return text


def alive(window):
    return window in Wnck.Screen.get_default().get_windows()


class DockItem(Gtk.Button):
    def __init__(self, dock, key, title):
        super().__init__()
        self.key, self.title, self.windows = key, title, []
        self.get_style_context().add_class('item')
        self.set_relief(Gtk.ReliefStyle.NONE)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.image = Gtk.Image()
        self.icon_source = None
        box.pack_start(self.image, False, False, 0)
        self.dots = Gtk.Box(spacing=0, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.dots.set_size_request(-1, 4)
        box.pack_start(self.dots, False, False, 0)
        self.add(box)
        self.connect('clicked', lambda _: dock.clicked(self))
        self.connect('button-press-event', dock.pressed, self)
        self.connect('key-press-event', dock.key_pressed, self)
        self.connect('popup-menu', lambda _: dock.manage_menu(self) or True)

    def refresh(self, windows, active, generic):
        self.windows = windows
        source = None if (ASSETS / (self.key + '.svg')).is_file() else (windows[0] if windows else None)
        signature = (source, source and source.get_icon(), generic)
        if self.image.get_pixbuf() is None or signature != self.icon_source:
            self.icon_source = signature
            self.image.set_from_pixbuf(icon_for(self.key, self.title, source, generic=generic))
        style = self.get_style_context()
        for name, on in [('running', bool(windows)), ('active', active in windows),
                         ('minimized', bool(windows) and all(w.is_minimized() for w in windows))]:
            (style.add_class if on else style.remove_class)(name)
        wanted = min(len(windows), MAX_DOTS)
        dots = self.dots.get_children()
        for dot in dots[wanted:]:
            dot.destroy()
        for index in range(len(dots), wanted):
            dot = Gtk.Box()
            dot.get_style_context().add_class('dot')
            self.dots.pack_start(dot, False, False, 0)
            dot.show()
        for index, dot in enumerate(self.dots.get_children()):
            (dot.get_style_context().add_class if index == 0 else dot.get_style_context().remove_class)('lead')
        text = describe(self.title, windows)
        self.set_tooltip_text(text)
        self.get_accessible().set_name(text)


class Dock(Gtk.Window):
    def __init__(self):
        super().__init__(title='Kindred Dock')
        self.set_wmclass('kindred-dock', 'Kindred Dock')
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.stick()
        self.set_keep_above(True)
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(self.get_screen(), css, 600)

        self.strip = Gtk.Box(spacing=0)
        self.strip.get_style_context().add_class('strip')
        self.add(self.strip)
        row = Gtk.Box(spacing=8, margin_start=10, margin_end=12)
        self.strip.pack_start(row, True, True, 0)

        self.left = Gtk.Box(valign=Gtk.Align.CENTER)
        self.applications = Gtk.Button()
        self.applications.get_style_context().add_class('apps')
        self.applications.set_tooltip_text('Search applications')
        self.applications.get_accessible().set_name('Applications')
        apps_box = Gtk.Box(spacing=9)
        apps_box.pack_start(Gtk.Image.new_from_pixbuf(icon_for('applications', 'Applications', size=28)),
                            False, False, 0)
        self.apps_label = Gtk.Label(label='Applications')
        self.apps_label.set_no_show_all(True)
        apps_box.pack_start(self.apps_label, False, False, 0)
        self.applications.add(apps_box)
        self.applications.connect('clicked', lambda _: self.launch('applications'))
        self.left.pack_start(self.applications, False, False, 0)
        row.pack_start(self.left, False, False, 0)

        self.tasks = Gtk.Box(spacing=2, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.scroll = Gtk.ScrolledWindow()
        # Overflowing icons scroll with the wheel or keyboard focus; no scrollbar eats the strip.
        self.scroll.set_policy(Gtk.PolicyType.EXTERNAL, Gtk.PolicyType.NEVER)
        self.scroll.add(self.tasks)
        self.tasks.set_focus_hadjustment(self.scroll.get_hadjustment())
        row.pack_start(self.scroll, True, True, 0)

        self.clock = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1, valign=Gtk.Align.CENTER)
        self.clock.get_style_context().add_class('clock')
        self.time = Gtk.Label(xalign=1)
        self.time.get_style_context().add_class('time')
        self.date = Gtk.Label(xalign=1)
        self.date.get_style_context().add_class('date')
        self.clock.pack_start(self.time, False, False, 0)
        self.clock.pack_start(self.date, False, False, 0)
        self.right = Gtk.Box(valign=Gtk.Align.CENTER)
        self.right.pack_end(self.clock, False, False, 0)
        row.pack_end(self.right, False, False, 0)
        # Equal side columns keep the icon group centred on wide screens.
        self.sides = Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL)

        self.items = {}
        self.divider = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        self.divider.get_style_context().add_class('divider')
        self.divider.set_no_show_all(True)
        for key, title in PINNED:
            self.items[key] = DockItem(self, key, title)
            self.tasks.pack_start(self.items[key], False, False, 0)
        self.tasks.pack_start(self.divider, False, False, 0)

        Wnck.set_default_icon_size(64)
        self.screen = Wnck.Screen.get_default()
        self.screen.force_update()
        self.groups = {}
        self.menu = None
        self.pending = None
        self.compact = None
        self.watched = set()
        self.screen.connect('window-opened', lambda _, window: self.watch(window))
        self.screen.connect('window-closed', self.forget)
        for signal in ['active-window-changed', 'active-workspace-changed']:
            self.screen.connect(signal, lambda *_: self.schedule())
        for window in self.screen.get_windows():
            self.watch(window)
        self.connect('realize', lambda _: self.geometry())
        self.get_screen().connect('size-changed', lambda _: self.geometry())
        self.connect('destroy', lambda _: Gtk.main_quit() if Gtk.main_level() else None)
        self.update()
        GLib.timeout_add_seconds(1, self.tick)
        self.show_all()

    def geometry(self):
        screen = self.get_screen()
        width, height = screen.get_width(), screen.get_height()
        self.set_size_request(width, HEIGHT)
        self.resize(width, HEIGHT)
        self.move(0, height - HEIGHT)
        compact = width < COMPACT
        if compact != self.compact:
            self.compact = compact
            (self.strip.get_style_context().add_class if compact else
             self.strip.get_style_context().remove_class)('compact')
            self.apps_label.set_visible(not compact)
            for side in [self.left, self.right]:
                if compact and side in self.sides.get_widgets():
                    self.sides.remove_widget(side)
                elif not compact:
                    self.sides.add_widget(side)
        xid = str(self.get_window().get_xid())
        # Reserve exactly this panel's height so maximized apps never cover it.
        for prop, values in [('_NET_WM_STRUT', [0, 0, 0, HEIGHT]),
                             ('_NET_WM_STRUT_PARTIAL', [0, 0, 0, HEIGHT, 0, 0, 0, 0, 0, 0, 0, width - 1])]:
            subprocess.run(['xprop', '-id', xid, '-f', prop, '32c', '-set', prop,
                            ', '.join(map(str, values))], check=True, capture_output=True)

    def schedule(self):
        # WM changes arrive as signal bursts; coalesce them into one in-place refresh.
        if self.pending is None:
            self.pending = GLib.idle_add(self.update)

    def watch(self, window):
        if window.get_xid() not in self.watched:
            self.watched.add(window.get_xid())
            for signal in ['state-changed', 'name-changed', 'icon-changed', 'class-changed',
                           'workspace-changed']:
                window.connect(signal, lambda *_: self.schedule())
        self.schedule()

    def forget(self, screen, window):
        self.watched.discard(window.get_xid())
        self.schedule()

    def launch(self, key):
        # GLib reaps the launcher and closes inherited descriptors, so apps never become zombies.
        GLib.spawn_async([LAUNCHER, key])

    def timestamp(self):
        return Gtk.get_current_event_time() or GdkX11.x11_get_server_time(self.get_window())

    def activate(self, window, timestamp):
        if not alive(window):
            return
        workspace = window.get_workspace()
        if workspace and workspace != self.screen.get_active_workspace():
            workspace.activate(timestamp)
        if window.is_minimized():
            window.unminimize(timestamp)
        # Brings forward a pending dialog (for example a save prompt) with its window.
        window.activate_transient(timestamp)

    def clicked(self, item):
        windows = [w for w in item.windows if alive(w)]
        if not windows:
            self.launch(item.key)
        elif len(windows) == 1:
            # Idempotent: clicking an already-focused app keeps it visible.
            self.activate(windows[0], self.timestamp())
        else:
            self.chooser(item)

    def pressed(self, button, event, item):
        if event.type != Gdk.EventType.BUTTON_PRESS:
            return False
        if event.button == 3:
            self.manage_menu(item, event)
            return True
        if event.button == 2 and item.key in NEW_WINDOW:
            self.launch(NEW_WINDOW[item.key])
            return True
        return False

    def key_pressed(self, button, event, item):
        if event.keyval == Gdk.KEY_Down and item.windows:
            self.chooser(item)
            return True
        return False

    def window_label(self, window):
        title = html.escape(window.get_name() or 'Untitled window')
        state = ' <span alpha="55%">· minimized</span>' if window.is_minimized() else ''
        mark = '●  ' if window == self.screen.get_active_window() else '    '
        return f'<span alpha="80%">{mark}</span>{title}{state}'

    def menu_item(self, markup, action=None, sensitive=True):
        item = Gtk.MenuItem(label='')
        label = item.get_child()
        label.set_markup(markup)
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.set_max_width_chars(52)
        item.set_sensitive(sensitive)
        if action:
            item.connect('activate', lambda _: action())
        return item

    def show_menu(self, menu, item, event=None):
        self.menu = menu
        menu.attach_to_widget(item, None)
        menu.connect('deactivate', lambda _: GLib.idle_add(self.menu_closed, menu))
        menu.show_all()
        if event:
            menu.popup_at_pointer(event)
        else:
            menu.popup_at_widget(item, Gdk.Gravity.NORTH, Gdk.Gravity.SOUTH, None)
        current = Gtk.get_current_event()
        if current and current.type == Gdk.EventType.KEY_PRESS:
            menu.select_first(True)

    def menu_closed(self, menu):
        if self.menu is menu:
            self.menu = None
        # Deferred: a chosen item activates after the menu deactivates.
        menu.destroy()
        return False

    def new_window_entry(self, item, menu):
        if item.key in dict(PINNED):
            if item.windows:
                menu.append(self.menu_item('New window', lambda: self.launch(NEW_WINDOW[item.key])))
            else:
                menu.append(self.menu_item(f'Open {item.title}', lambda: self.launch(item.key)))

    def chooser(self, item):
        """Left-click with several windows: pick one; the list is ordered by stacking."""
        menu = Gtk.Menu()
        for window in item.windows:
            menu.append(self.menu_item(self.window_label(window),
                                       lambda w=window: self.activate(w, self.timestamp())))
        if item.key in dict(PINNED):
            menu.append(Gtk.SeparatorMenuItem())
            self.new_window_entry(item, menu)
        self.show_menu(menu, item)

    def manage_menu(self, item, event=None):
        menu = Gtk.Menu()
        menu.append(self.menu_item(f'<b>{html.escape(item.title)}</b>', sensitive=False))
        for window in item.windows:
            entry = self.menu_item(self.window_label(window))
            submenu = Gtk.Menu()
            actions = [('Show window', lambda w: self.activate(w, self.timestamp()))]
            if not window.is_minimized():
                actions.append(('Minimize', lambda w: alive(w) and w.minimize()))
            actions.append(('Close window', lambda w: alive(w) and w.close(self.timestamp())))
            for label, action in actions:
                submenu.append(self.menu_item(label, lambda w=window, fn=action: fn(w)))
            entry.set_submenu(submenu)
            menu.append(entry)
        if not item.windows:
            menu.append(self.menu_item('No open windows', sensitive=False))
        if item.key in dict(PINNED) or len(item.windows) > 1:
            menu.append(Gtk.SeparatorMenuItem())
        self.new_window_entry(item, menu)
        if len(item.windows) > 1:
            menu.append(self.menu_item('Close all windows',
                                       lambda: [alive(w) and w.close(self.timestamp()) for w in item.windows]))
        self.show_menu(menu, item, event)

    def tick(self):
        now = datetime.datetime.now().astimezone()
        self.time.set_text(now.strftime('%H:%M'))
        self.date.set_text(now.strftime('%a %-d %b') + ' · ' + now.strftime('%Z'))
        offset = now.strftime('%z')
        offset = ('UTC' + offset[0].replace('-', '−') + offset[1:3] + ':' + offset[3:]) if offset else 'UTC'
        zone = timezone_name()
        self.clock.set_tooltip_text(now.strftime('%A %-d %B %Y') + '\n' + ' · '.join(filter(None, [zone, offset])))
        return True

    def generic_icon(self):
        # The dock sets no icon itself, so the WM's stock icon for it identifies icon-less apps.
        own = self.get_window() and Wnck.Window.get(self.get_window().get_xid())
        return own.get_icon().get_pixels() if own and own.get_icon() else None

    def update(self):
        self.pending = None
        self.tick()
        groups = {}
        for window in self.screen.get_windows_stacked() or []:
            if window.is_skip_tasklist():
                continue
            groups.setdefault(app_key(window), []).append(window)
        for windows in groups.values():
            windows.reverse()  # Topmost first.
        self.groups = groups
        active = self.screen.get_active_window()
        for key in list(self.items):
            if key not in groups and key not in dict(PINNED):
                self.items.pop(key).destroy()
        # Unpinned apps keep their dock position while open, appended after the divider.
        position = len(PINNED) + 1
        for key, windows in groups.items():
            if key in dict(PINNED) or key in self.items:
                continue
            self.items[key] = DockItem(self, key, app_title(windows[0]))
            self.tasks.pack_start(self.items[key], False, False, 0)
        for key, item in self.items.items():
            if key not in dict(PINNED):
                self.tasks.reorder_child(item, position)
                position += 1
            item.refresh(groups.get(key, []), active, self.generic_icon())
            item.show_all()
        self.divider.set_visible(len(self.items) > len(PINNED))
        return False


if __name__ == '__main__':
    Wnck.set_client_type(Wnck.ClientType.PAGER)
    Dock()
    Gtk.main()
