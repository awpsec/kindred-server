#!/usr/bin/python3
"""Kindred's X11 panel. Window state comes from the WM, including minimized windows."""
import datetime
import html
import os
from pathlib import Path
import subprocess

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GdkX11', '3.0')
gi.require_version('Wnck', '3.0')
gi.require_version('Pango', '1.0')
from gi.repository import Gdk, GdkPixbuf, GdkX11, GLib, Gtk, Pango, Wnck

ASSETS = Path(os.environ.get('KINDRED_DOCK_ASSETS', '/usr/local/share/kindred/desktop'))
LAUNCHER = os.environ.get('KINDRED_DOCK_LAUNCHER', '/usr/local/lib/kindred/desktop-launch')
PINNED = [('browser', 'Browser'), ('files', 'Files'), ('terminal', 'Terminal')]
# Launcher actions that always open another window; plain 'browser' restores the last session.
NEW_WINDOW = {'browser': 'browser-new', 'files': 'files', 'terminal': 'terminal'}
ALIASES = [('browser', ('chromium',)), ('files', ('pcmanfm',)), ('terminal', ('konsole', 'xterm'))]
HEIGHT = 64      # Reserved strip; maximized windows stop above it.
ICON = 36
COMPACT = 820    # Below this width the Applications label and centring give way to icons.
MAX_DOTS = 3
TILES = ['#333944', '#2e3d4c', '#3b3549', '#2d4340', '#46392f', '#40333c']  # Muted, icon-less apps.

# Scoped to the dock process only (its own windows, menus and tooltips).
CSS = b'''
