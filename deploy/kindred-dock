         background-image: linear-gradient(to bottom, #1a1d23, #131519);
         border-top: 1px solid rgba(255, 255, 255, 0.07); color: #edf0f5; }
button { background: transparent; border: none; box-shadow: none; text-shadow: none;
         -gtk-icon-shadow: none; color: #edf0f5; border-radius: 12px; padding: 0;
         outline: 2px solid rgba(138, 180, 248, 0.8); outline-offset: -2px; -gtk-outline-radius: 11px;
         transition: background-color 160ms ease-out; }
